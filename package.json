{
  "name": "kudos-jaya",
  "version": "1.4.1",
  "description": "Share warm kudos and kind words with anyone in your workspace using functions and a workflow!",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp -r config dist",
    "start": "node dist/src/app.js",
    "start:local": "dotenv -e .env -- ts-node-dev -r tsconfig-paths/register --transpile-only src/app.ts|pino-pretty -c",
    "start:watch": "dotenv -e .env -- nodemon --watch src --exec ts-node -r tsconfig-paths/register src/app.ts|pino-pretty -c",
    "test": "NODE_ENV=test dotenv -e .env -- jest",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "dotenv -e .env -- npm run typeorm -- migration:create ./src/migrations/$npm_config_name",
    "migration:gen": "dotenv -e .env -- npm run typeorm -- migration:generate -d ./src/data-source.ts ./src/migrations/$npm_config_name --pretty",
    "migration:up": "dotenv -e .env -- npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:down": "dotenv -e .env -- npm run typeorm -- migration:revert -d ./src/data-source.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@slack/bolt": "^4.2.1",
    "axios": "^1.8.4",
    "config": "^3.3.12",
    "dotenv": "~16.4.7",
    "fast-csv": "^5.0.2",
    "module-alias": "^2.2.3",
    "node-cache": "^5.1.2",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@types/config": "^3.3.5",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.13.13",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.2"
  }
}
