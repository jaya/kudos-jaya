{
  "name": "kudos-jaya",
  "version": "1.0.0",
  "description": "Share warm kudos and kind words with anyone in your workspace using functions and a workflow!",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp -r config dist",
    "start": "node dist/src/app.js",
    "start:local": "dotenv -e .env -- ts-node-dev -r tsconfig-paths/register --transpile-only src/app.ts|pino-pretty -c",
    "start:watch": "dotenv -e .env -- nodemon --watch src --exec ts-node -r tsconfig-paths/register src/app.ts|pino-pretty -c",
    "test": "NODE_ENV=test dotenv -e .env -- jest",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:gen": "npm run typeorm -- migration:generate $npm_config_name -d src/data-source.ts --pretty",
    "migration:up": "npm run typeorm -- migration:run -d src/data-source.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@slack/bolt": "^4.1.0",
    "axios": "^1.7.7",
    "config": "^3.3.12",
    "dotenv": "~16.4.5",
    "module-alias": "^2.2.3",
    "node-cache": "^5.1.2",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.20",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/config": "^3.3.5",
    "@types/jest": "^29.5.13",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.8.7",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "~8.57.0",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "~2.29.1",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
