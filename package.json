{
  "name": "kudos-jaya",
  "version": "1.7.0",
  "description": "Share warm kudos and kind words with anyone in your workspace using functions and a workflow!",
  "main": "index.js",
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "build": "tsc && cp -r config dist",
    "start": "dotenv -- node dist/src/app.js",
    "start:mock-server": "dotenv -e .env -- ts-node-dev -r tsconfig-paths/register --transpile-only src/mock-server/index.ts|pino-pretty -c",
    "start:local": "concurrently \"npm run start:mock-server\" \"sh -c 'TODO_BASE_URL=http://localhost:3001 dotenv -e .env -- ts-node-dev -r tsconfig-paths/register --transpile-only src/app.ts|pino-pretty -c'\"",
    "start:watch": "dotenv -e .env -- nodemon --watch src --exec ts-node -r tsconfig-paths/register src/app.ts|pino-pretty -c",
    "test": "NODE_ENV=test dotenv -e .env -- jest",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "dotenv -e .env -- npm run typeorm -- migration:create ./src/migrations/$npm_config_name",
    "migration:gen": "dotenv -e .env -- npm run typeorm -- migration:generate -d ./src/data-source.ts ./src/migrations/$npm_config_name --pretty",
    "migration:up": "dotenv -e .env -- npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:down": "dotenv -e .env -- npm run typeorm -- migration:revert -d ./src/data-source.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "axios": "^1.13.4",
    "config": "^4.2.0",
    "dotenv": "~17.2.3",
    "express": "^4.18.2",
    "fast-csv": "^5.0.5",
    "husky": "^9.1.7",
    "module-alias": "^2.2.3",
    "node-cache": "^5.1.2",
    "pg": "^8.17.2",
    "pino": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jest": "^30.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
